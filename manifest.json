{
  "name": "axure-analyzer",
  "version": "0.2.0",
  "description": "Analyze Axure RP HTML prototype exports: page structure, breadcrumbs, rendered text geometry, sticky requirement annotations, image-based OCR, interactions, and implementation baselines.",
  "skills": [
    "axure-analyzer"
  ],
  "scripts": [
    "scripts/analyze.js",
    "scripts/render_pages.js",
    "scripts/build_baseline.js",
    "scripts/ocr_pages.js",
    "scripts/ocr_image.py",
    "scripts/axure/ingest_axure_html.js",
    "scripts/axure/make_axure_context_pack.js",
    "scripts/axure/make_requirements_doc.js"
  ],
  "defaultMode": "static-prototype",
  "targetSkillRoot": ".opencode/skills",
  "requires": {
    "node": ">=18",
    "chrome": "system Chrome or Edge",
    "npm": "playwright-core",
    "ocr": "optional: python -m pip install rapidocr_onnxruntime"
  }
}
